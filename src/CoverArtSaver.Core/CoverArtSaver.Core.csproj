<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain .NET library with no Windows/WPF dependencies: settings, library loading, filtering,
    command-line parsing and the coverflow layout math. Keeping it UI-free means it can be
    unit-tested on any OS (see tests/CoverArtSaver.Tests).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CoverArtSaver.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoverArtSaver.Tests" />
  </ItemGroup>

</Project>
