<Window x:Class="CoverArtSaver.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Game Cover Art Screensaver Settings"
        Width="620" Height="700" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <!-- DataContext is a copy of SaverSettings; bindings write into it, OK saves it, Cancel discards it. -->
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Foreground" Value="#555" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Test full screen" Padding="12,4" Margin="0,0,24,0" Click="OnTestClick"
                    ToolTip="Runs the screensaver with the settings above. Move the mouse or press a key to come back." />
            <Button Content="OK" Width="88" Padding="0,4" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Width="88" Padding="0,4" IsCancel="True" />
        </StackPanel>

        <!-- Shown when GitHub has a newer version (see OnLoadedCheckForUpdates). -->
        <Border DockPanel.Dock="Top" x:Name="UpdateBanner" Visibility="Collapsed" Background="#FFF6D6" BorderBrush="#E8C66A"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowButton" Content="Update now" Padding="10,2" Margin="8,0,0,0" Click="OnUpdateNowClick" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run x:Name="UpdateBannerText" FontWeight="SemiBold" />
                    <Hyperlink x:Name="UpdateNotesLink" RequestNavigate="OnLinkClick">What's new</Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>

        <TabControl>
            <!-- ================= Display ================= -->
            <TabItem Header="Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="Style">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource Label}" Text="Screensaver style" />
                                <ComboBox Grid.Column="1" x:Name="LayoutCombo" SelectedItem="{Binding Layout}" Margin="0,4"
                                          SelectionChanged="OnLayoutChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LayoutDescription" TextWrapping="Wrap"
                                           Foreground="#666" FontSize="11" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Order" />
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OrderCombo" SelectedItem="{Binding Order}" Margin="0,4" />
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="MosaicGroup" Header="Mosaic">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource Label}" Text="Covers across the screen" />
                                <Slider Grid.Column="1" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding MosaicColumns}" ValueChanged="OnMosaicColumnsChanged" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MosaicColumns}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MosaicRowsText" Foreground="#666" FontSize="11"
                                           Margin="0,0,0,4" />

                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Time between flips" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Value="{Binding MosaicFlipSeconds}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MosaicFlipSeconds, StringFormat={}{0:0.0} s}" />

                                <CheckBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="FeaturedCheck" Margin="0,10,0,4"
                                          Content="Show some games as large tiles"
                                          IsChecked="{Binding MosaicFeatured.Enabled}"
                                          ToolTip="Some games get tiles that span several cells, and move around the wall as they flip." />

                                <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="20,0,0,0" DataContext="{Binding MosaicFeatured}"
                                      IsEnabled="{Binding IsChecked, ElementName=FeaturedCheck}" Grid.IsSharedSizeScope="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FeaturedLabel" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FeaturedValue" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource Label}" Text="Which games" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="FeaturedModeCombo" Margin="0,4"
                                              SelectedValue="{Binding Mode}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                              SelectionChanged="OnFeaturedModeChanged" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Large tile size" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                            TickPlacement="BottomRight" Value="{Binding Size}"
                                            ToolTip="How many normal tiles wide and tall a large tile is. It's left out on screens too small for it." />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Size, StringFormat={}{0} × {0} tiles}" />

                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Large tiles on screen" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                            TickPlacement="BottomRight" Value="{Binding Count}"
                                            ToolTip="Fewer are shown if they don't fit, or if fewer games qualify." />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Count}" />

                                    <!-- Only for "games you've barely played". -->
                                    <Grid Grid.Row="3" Grid.ColumnSpan="3" x:Name="BarelyPlayedOptions">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FeaturedLabel" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FeaturedValue" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>

                                        <TextBlock Style="{StaticResource Label}" Text="Played for at most" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding MaxPlaytimeHours}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MaxPlaytimeHours, StringFormat={}{0} h}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#666" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Text="0 h = only games with no play time recorded." />

                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Review rating" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RatingCombo" Margin="0,4"
                                                  SelectedValue="{Binding MinimumRating}" SelectedValuePath="Key" DisplayMemberPath="Value" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="#666" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap">
                                            Steam: the game's user review rating on Steam. Playnite: the Community Score, or the Critic Score
                                            if there's none (Overwhelmingly Positive = 95+, Very Positive and Positive = 80+,
                                            Mostly Positive = 70+, Mixed = 40+). Games without a rating are left out.
                                        </TextBlock>

                                        <!-- Playnite only: games whose "0 hours" may just mean they were played outside Playnite. -->
                                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Leave out" VerticalAlignment="Top"
                                                   x:Name="SkipLabel" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SkipPanel">
                                            <CheckBox Content="Games added to Playnite by hand" IsChecked="{Binding SkipManuallyAdded}"
                                                      ToolTip="Games that no library integration imported, such as emulated games or ones you added yourself." />
                                            <TextBlock Text="Games from these libraries:" Margin="0,4,0,0" />
                                            <WrapPanel x:Name="SkipLibrariesPanel" Margin="0,0,0,2" />
                                            <TextBlock Foreground="#666" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap">
                                                For stores that can't tell Playnite how long you've played. Ticked at first: every store
                                                except Steam, Epic, GOG, Xbox, PlayStation and EA app, which do report it. Playnite only
                                                counts the time for the others if you start them from Playnite, so 0 hours may not be true. Games left out still appear as normal tiles. If your libraries aren't listed,
                                                update the Playnite add-on and export again.
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="FeaturedSummary" TextWrapping="Wrap" Margin="0,4,0,2" />
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="CoverflowGroup" Header="Coverflow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource Label}" Text="Time on each cover" />
                                <Slider Grid.Column="1" Minimum="1" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding SecondsPerCover}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding SecondsPerCover, StringFormat={}{0:0.#} s}" />

                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Slide duration" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Value="{Binding TransitionSeconds}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding TransitionSeconds, StringFormat={}{0:0.0} s}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Covers on each side" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SideCovers}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding SideCovers}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Side cover angle" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="85" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding SideAngle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding SideAngle, StringFormat={}{0}°}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Appearance">
                            <StackPanel>
                                <StackPanel x:Name="CoverflowAppearance">
                                    <CheckBox Content="Show reflections" IsChecked="{Binding ShowReflection}" />
                                    <CheckBox Content="Show game title" IsChecked="{Binding ShowTitle}" />
                                    <CheckBox Content="Show platform and release year under the title" IsChecked="{Binding ShowDetails}"
                                              IsEnabled="{Binding ShowTitle}" Margin="20,4,0,4" />
                                </StackPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Cover image quality" />
                                    <Slider Grid.Column="1" Minimum="256" Maximum="1600" TickFrequency="64" IsSnapToTickEnabled="True"
                                            Value="{Binding TextureHeight}"
                                            ToolTip="Higher looks sharper on 4K screens but uses more memory." />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding TextureHeight, StringFormat={}{0} px}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Screens and input">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Multiple monitors" />
                                <ComboBox Grid.Column="1" x:Name="MonitorCombo" SelectedItem="{Binding MultiMonitor}" Margin="0,4"
                                          SelectionChanged="OnMonitorModeChanged" />

                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="TakeTurnsCheck" IsChecked="{Binding MonitorsTakeTurns}"
                                          Content="Monitors take turns (one change at a time)"
                                          ToolTip="Instead of every monitor changing at the same moment, the change moves from monitor to monitor. Only for Independent monitors: mirrored ones always change together." />

                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Mouse movement to exit" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="2" IsSnapToTickEnabled="True"
                                        Value="{Binding MouseMoveThreshold}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MouseMoveThreshold, StringFormat={}{0} px}" />
                            </Grid>
                        </GroupBox>

                        <TextBlock TextWrapping="Wrap" Foreground="#666">
                            Wait time and "On resume, display logon screen" are set in Windows' own Screen Saver Settings dialog.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Library & filters ================= -->
            <TabItem Header="Library &amp; filters">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="Game library">
                            <StackPanel>
                                <DockPanel Margin="0,2,0,6">
                                    <TextBlock Text="Get games from" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="SourceCombo" SelectedValue="{Binding Source}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                              SelectionChanged="OnSourceChanged" />
                                </DockPanel>
                                <TextBlock x:Name="LibraryStatus" TextWrapping="Wrap" Margin="0,2,0,8" />

                                <StackPanel x:Name="PlaynitePanel">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="OnBrowseClick" />
                                        <TextBox x:Name="LibraryPathBox" Text="{Binding LibraryFileOverride, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Leave empty to use the add-on's default location." />
                                    </DockPanel>
                                    <TextBlock Foreground="#666" FontSize="11" Margin="0,2,0,0">Custom export file (leave empty for the default)</TextBlock>
                                </StackPanel>

                                <StackPanel x:Name="SteamPanel">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="OnBrowseSteamClick" />
                                        <TextBox x:Name="SteamPathBox" Text="{Binding SteamFolderOverride, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Leave empty to find Steam automatically." />
                                    </DockPanel>
                                    <TextBlock Foreground="#666" FontSize="11" Margin="0,2,0,0">Steam folder (leave empty to find it automatically)</TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,6,0,0">
                                        Reads Steam's own files, so no add-on is needed and Steam doesn't have to be running. Uses the
                                        Steam account that signed in most recently. Games appear once Steam has downloaded their cover
                                        art, which happens when you open your library in Steam.
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Which games">
                            <StackPanel DataContext="{Binding Filter}">
                                <CheckBox Content="Include hidden games" IsChecked="{Binding IncludeHidden}" />
                                <CheckBox Content="Installed games only" IsChecked="{Binding InstalledOnly}" />
                                <CheckBox Content="Favorites only" IsChecked="{Binding FavoritesOnly}" />
                                <CheckBox Content="Skip games without cover art (otherwise show a title card)" IsChecked="{Binding SkipGamesWithoutCover}" />
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Cover shape" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="ShapeCombo" SelectedValue="{Binding CoverShape}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                              SelectionChanged="OnShapeChanged"
                                              ToolTip="Use only covers of one shape so the screensaver looks consistent. Games without art count as vertical (they get a title card)." />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Content filter">
                            <StackPanel DataContext="{Binding Filter}">
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Games with nudity or sexual content" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="AdultCombo" SelectedValue="{Binding AdultContent}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                              SelectionChanged="OnContentModeChanged" />
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="20,0,0,4">
                                    A game matches if any of its tags, genres, features, categories or age ratings contains one of
                                    these words (one per line, whole-word, not case-sensitive):
                                </TextBlock>
                                <TextBox x:Name="AdultKeywordsBox" Margin="20,0,0,6" Height="110" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" />

                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Games rated Mature / 18+ (includes violence-only ratings)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="MatureCombo" SelectedValue="{Binding MatureRatings}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                              SelectionChanged="OnContentModeChanged"
                                              ToolTip="If both lists are set to &quot;Show only&quot;, games matching either list are shown." />
                                </DockPanel>
                                <TextBox x:Name="MatureKeywordsBox" Margin="20,0,0,6" Height="80" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" />

                                <Button Content="Reset word lists to defaults" HorizontalAlignment="Left" Padding="10,2" Margin="20,0,0,10"
                                        Click="OnResetKeywordsClick" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Always hide games tagged" />
                                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding HideTag, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Always allow games tagged" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding ShowTag, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Overrides the content filter for games it catches by mistake." />
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,4,0,0">
                                    Playnite: add these as tags (select games → right-click → Edit → Tags).
                                    Steam: create a collection with this name and add games to it.
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <Border Background="#F0F4FA" Padding="10" CornerRadius="4">
                            <TextBlock x:Name="FilterSummary" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Music ================= -->
            <TabItem Header="Music">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" DataContext="{Binding Music}">
                        <GroupBox Header="Steam soundtracks">
                            <StackPanel>
                                <CheckBox x:Name="MusicCheck" IsChecked="{Binding Enabled}"
                                          Content="Play my installed Steam soundtracks while the screensaver runs" />

                                <StackPanel Margin="20,0,0,0" IsEnabled="{Binding IsChecked, ElementName=MusicCheck}">
                                    <CheckBox x:Name="ShuffleCheck" Content="Shuffle" IsChecked="{Binding Shuffle}"
                                              ToolTip="Plays every track once in a random order, then reshuffles. Off: album by album, in track order." />
                                    <CheckBox Content="Start at a random track" IsChecked="{Binding StartAtRandomTrack}"
                                              ToolTip="Without shuffle, start somewhere random instead of at the first track, then carry on in order. With shuffle on, the first track is always random.">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ShuffleCheck}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Volume" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding Volume}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Volume, StringFormat={}{0}%}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="MusicStatus" TextWrapping="Wrap" Margin="0,8,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11">
                                    The music always comes from Steam, even when your games come from Playnite, because Playnite
                                    doesn't keep track of soundtracks. Soundtracks you own appear in your Steam library and install
                                    like games. It plays in full screen and with Test full screen, but not in the small preview in
                                    Windows' Screen Saver Settings.
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= About ================= -->
            <TabItem Header="About">
                <StackPanel Margin="16">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="PC Game Cover Art Screensaver" />
                    <TextBlock x:Name="VersionText" Foreground="#666" Margin="0,2,0,6" />
                    <CheckBox Content="Check for updates when this window opens" IsChecked="{Binding CheckForUpdates}"
                              ToolTip="Asks GitHub whether there's a newer version. Only this window does it; the screensaver itself never goes online." />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                        <Button Content="Check now" Padding="10,2" Click="OnCheckNowClick" />
                        <TextBlock x:Name="UpdateStatus" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap">
                        Shows the cover art from your Playnite or Steam library as a classic coverflow or a flipping mosaic,
                        optionally with your installed Steam soundtracks playing.
                        Playnite needs the "PC Game Cover Art Exporter" add-on; Steam needs nothing extra.
                    </TextBlock>
                    <TextBlock x:Name="CopyrightText" TextWrapping="Wrap" Foreground="#666" Margin="0,12,0,0" />
                    <TextBlock Margin="0,6,0,0">
                        <Hyperlink Click="OnLicenseClick">MIT License</Hyperlink>
                        <Run Text="  ·  " Foreground="#999" />
                        <Hyperlink Click="OnNoticesClick">Third-party notices</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,12,0,0">
                        <Hyperlink x:Name="RepoLink" RequestNavigate="OnLinkClick">Project page on GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0">
                        <Hyperlink x:Name="DataFolderLink" RequestNavigate="OnLinkClick">Open data folder (settings, library export, log)</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
