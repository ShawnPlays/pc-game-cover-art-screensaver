<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Playnite 10 add-ons run inside Playnite itself, which is a .NET Framework 4.6.2 app,
    so this project must target net462 (not modern .NET like the screensaver does).
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CoverArtExporter</AssemblyName>
    <RootNamespace>CoverArtExporter</RootNamespace>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.4.0</Version>
    <Nullable>disable</Nullable>
    <!-- Lets the project build on non-Windows CI/dev boxes too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Playnite already ships Playnite.SDK.dll, so we compile against it but do NOT copy it
      into our output (ExcludeAssets=runtime). Shipping our own copy can cause version clashes.
    -->
    <PackageReference Include="PlayniteSDK" Version="6.17.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Reference assemblies so net462 builds without the .NET Framework developer pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
