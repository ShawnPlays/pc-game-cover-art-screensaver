<Project>

  <!--
    Shared by every project in the repository. The copyright is stamped into each .exe/.dll/.scr,
    where Windows shows it under Properties → Details. Keep it in step with the LICENSE file.
  -->
  <PropertyGroup>
    <Authors>ShawnPlays</Authors>
    <Copyright>Copyright (c) 2026 ShawnPlays. Released under the MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ShawnPlays/pc-game-cover-art-screensaver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShawnPlays/pc-game-cover-art-screensaver</RepositoryUrl>
  </PropertyGroup>

</Project>
