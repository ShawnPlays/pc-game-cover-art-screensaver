<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": signs PCGameCoverArtSetup_<version>.exe, which already contains the
  signed screensaver. The workflow uploads just that one file as a GitHub Actions artifact (a ZIP).
  Paste this into SignPath: project → Artifact configurations → New, slug "installer".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="PCGameCoverArtSetup_${version}.exe" product-name="PC Game Cover Art Screensaver" product-version="${version}" min-matches="1" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
